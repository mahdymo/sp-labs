# ==============================================================================
# SP-Labs Environment Configuration
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# --- General ---
LAB_DOMAIN=sp-labs.local
TIMEZONE=UTC

# --- 5G Core (Open5GS) ---
OPEN5GS_VERSION=v2.7.0
MONGODB_VERSION=6.0

# MCC/MNC (PLMN) — Default: Test network 999/70
MCC=999
MNC=70
TAC=1

# Subscriber defaults
SUBSCRIBER_IMSI=999700000000001
SUBSCRIBER_KEY=465B5CE8B199B49FAA5F0A2EE238A6BC
SUBSCRIBER_OPC=E8ED289DEBA952E4283B54E88E6183CA
SUBSCRIBER_APN=internet
SUBSCRIBER_SST=1

# --- UERANSIM ---
UERANSIM_VERSION=v3.2.6
GNB_ID=1
NUM_UES=5

# --- 6G Lab ---
SIONNA_VERSION=0.19.1
NS3_VERSION=3.42

# --- Monitoring ---
GRAFANA_VERSION=11.3.0
PROMETHEUS_VERSION=v2.55.0
GRAFANA_ADMIN_PASSWORD=sp-labs-admin
NODE_EXPORTER_VERSION=v1.8.2

# --- Networking (Docker bridge subnets) ---
NET_SBI=10.33.33.0/24
NET_N2=10.33.34.0/24
NET_N3=10.33.35.0/24
NET_N4=10.33.36.0/24
NET_N6=10.33.37.0/24
NET_MGMT=10.33.38.0/24

# ==============================================================================
# MULTI-VM DEPLOYMENT (only needed if deploying across multiple VMs)
# ==============================================================================
# Set these to the management IPs of your target VMs.
# The jump host uses these for Ansible SSH connections.
# Leave commented out for single-host deployment.

# VM_5G_CORE_IP=192.168.1.10
# VM_RAN_SIM_IP=192.168.1.20
# VM_SIONNA_IP=192.168.1.40
# VM_NS3_IP=192.168.1.50
# VM_ORAN_IP=192.168.1.60
# VM_MONITOR_IP=192.168.1.70

# --- SSH / Ansible ---
# ANSIBLE_USER=ubuntu
# ANSIBLE_SSH_KEY=~/.ssh/sp-labs-key
# ANSIBLE_SSH_PORT=22

# --- HTTP Proxy (if VMs are behind a proxy) ---
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1,10.33.33.0/24,10.33.34.0/24
